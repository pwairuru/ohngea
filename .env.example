# Ohngea PBX — 12-factor config
# Copy to .env and adjust for local dev
DATABASE_URL=postgresql+asyncpg://ohngea:ohngea@localhost:5432/ohngea
# Valkey is primary cache/broker (protocol-compatible with Redis). Use valkey:// for app code.
VALKEY_URL=valkey://localhost:6379/0
# REDIS_URL kept for backwards compat and celery/kombu (which still require redis:// scheme)
# Both point to same Valkey service; redis://valkey:6379/0 works against valkey server.
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-secret-change
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
FS_ESL_HOST=127.0.0.1
FS_ESL_PORT=8021
FS_ESL_PASSWORD=ClueCon
FS_XML_USER=freeswitch
FS_XML_PASSWORD=ClueCon
# S3 / MinIO object store for recordings (partitioned recordings/{domain_id}/...)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ohngea-recordings
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PRESIGN_TTL=3600
# SMTP for email_queue worker (Mailpit in docker-compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=noreply@ohngea.local
