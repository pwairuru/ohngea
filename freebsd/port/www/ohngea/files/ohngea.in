#!/bin/sh
# PROVIDE: ohngea
# REQUIRE: NETWORKING postgresql
# BEFORE: nginx
# KEYWORD: shutdown

. /etc/rc.subr

name=ohngea
rcvar=ohngea_enable

load_rc_config $name

: ${ohngea_enable:=NO}
: ${ohngea_user:=ohngea}
: ${ohngea_host:=127.0.0.1}
: ${ohngea_port:=8000}
: ${ohngea_env_file:=%%ETCDIR%%/ohngea.env}

command="%%PREFIX%%/bin/pbx-api"
procname="%%PREFIX%%/bin/pbx-api"

# NOTE: pbx-api binds 0.0.0.0:${PORT} itself and migrates on boot
# (SeaORM Migrator up); ohngea_host is kept for helper health polls.
ohngea_precmd() {
    if [ -f "${ohngea_env_file}" ]; then
        set -a
        . "${ohngea_env_file}"
        set +a
    fi
    : ${PORT:=${ohngea_port}}
    export PORT
}

start_precmd=ohngea_precmd

required_files="%%ETCDIR%%/ohngea.env %%PREFIX%%/bin/pbx-api"

run_rc_command "$1"
