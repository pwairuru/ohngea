# Ohngea PBX environment — installed as %%ETCDIR%%/ohngea.env.sample
# Copied to %%ETCDIR%%/ohngea.env on first boot (ohngea_init); never rewritten after.
# postgresql:// scheme only — never postgresql+asyncpg://.
DATABASE_URL=postgresql://ohngea:ohngea@localhost:5432/ohngea
# Release binary exits 1 on empty, test-secret, or dev-secret-change: ohngea_init
# replaces this with `openssl rand -hex 32` on the fresh file only.
JWT_SECRET=dev-secret-change
FS_ESL_HOST=127.0.0.1
FS_ESL_PORT=8021
FS_ESL_PASSWORD=ClueCon
FS_XML_USER=freeswitch
FS_XML_PASSWORD=ClueCon
PORT=8000
