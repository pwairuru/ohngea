#!/bin/sh
# ohngea-setup — helper for Ohngea PBX on FreeBSD
# Usage: ohngea-setup [init|migrate|gen-secret|check]

set -eu

ETCDIR=${ETCDIR:-/usr/local/etc/ohngea}
ENV_FILE=${ENV_FILE:-${ETCDIR}/ohngea.env}

usage() {
    cat <<EOF
Usage: ohngea-setup <command>

Commands:
  init        Enable + run first-boot init (delegates to service ohngea_init)
  migrate     Note on migrate-on-boot (pbx-api migrates at startup)
  gen-secret  Generate JWT secret
  check       Health check services
  help        Show this

ETCDIR=${ETCDIR}
EOF
    exit 0
}

gen_secret() {
    openssl rand -hex 32
}

migrate() {
    echo "pbx-api migrates on boot (SeaORM Migrator up) — no manual step needed."
    echo "To apply pending migrations, restart: service ohngea restart"
}

init() {
    echo "== Ohngea PBX init =="
    sysrc ohngea_enable=YES ohngea_init_enable=YES
    service ohngea_init start
    echo "When init finishes, your URL is shown via: ohngea-url"
}

check() {
    echo "== Ohngea check =="
    for svc in postgresql nginx freeswitch ohngea; do
        service $svc status || echo "$svc not running"
    done
    fetch -o - http://127.0.0.1:8000/health && echo "API health ok" || echo "API health FAIL"
    fetch -o - http://127.0.0.1:8000/api/v1/health && echo "API v1 ok" || echo "API v1 FAIL"
}

cmd=${1:-help}
case "$cmd" in
    init) init ;;
    migrate) migrate ;;
    gen-secret) gen_secret ;;
    check) check ;;
    help|--help|-h) usage ;;
    *) echo "Unknown $cmd" >&2; usage ;;
esac
