#!/bin/sh
# PROVIDE: ohngea_beat
# REQUIRE: NETWORKING postgresql valkey
# KEYWORD: shutdown

. /etc/rc.subr

name=ohngea_beat
rcvar=ohngea_beat_enable

load_rc_config $name

: ${ohngea_beat_enable:=NO}
: ${ohngea_beat_user:=ohngea}
: ${ohngea_beat_group:=ohngea}
: ${ohngea_beat_dir:=%%WWWDIR%%}
: ${ohngea_beat_env_file:=%%ETCDIR%%/ohngea.env}
: ${ohngea_beat_pidfile:=/var/run/ohngea_beat.pid}
: ${ohngea_beat_schedule:=/var/db/ohngea/celerybeat-schedule}
: ${ohngea_beat_logfile:=/var/log/ohngea_beat.log}

pidfile=${ohngea_beat_pidfile}
command="/usr/sbin/daemon"
command_args="-p ${ohngea_beat_pidfile} -u ${ohngea_beat_user} %%WWWDIR%%/.venv/bin/celery -A app.workers.celery_app beat --loglevel=info --pidfile=${ohngea_beat_pidfile} --schedule=${ohngea_beat_schedule} --logfile=${ohngea_beat_logfile}"

ohngea_beat_precmd() {
    install -d -o ${ohngea_beat_user} -g ${ohngea_beat_group} -m 755 /var/run /var/log /var/db/ohngea
    touch ${ohngea_beat_logfile} && chown ${ohngea_beat_user}:${ohngea_beat_group} ${ohngea_beat_logfile}
    if [ -f "${ohngea_beat_env_file}" ]; then
        set -a
        . "${ohngea_beat_env_file}"
        set +a
    fi
    cd "${ohngea_beat_dir}" || return 1
}

start_precmd=ohngea_beat_precmd

run_rc_command "$1"
