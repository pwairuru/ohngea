{"nodes": [{"id": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_doc", "label": "Ohngea PBX Clone Architecture Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-21-ohngea-modern-clone-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_fastapi_monolith", "label": "FastAPI Monolith Control Plane", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-21-ohngea-modern-clone-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single modular FastAPI monolith chosen over microservices initially so one deploy unit scales control plane via replicas while media scales via FreeSWITCH pods; keeps 80-120K LOC target vs 489K PHP legacy."}, {"id": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_postgres_rls_partitioning", "label": "PostgreSQL RLS Hash Partitioning", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-21-ohngea-modern-clone-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Partition by HASH(domain_id) plus RLS chosen to replace manual WHERE domain_uuid filters and ClickHouse sidecar; gives per-tenant pruning, easy DROP/COPY per tenant, keeps stack to single Postgres."}, {"id": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_mod_xml_curl", "label": "mod_xml_curl On-Demand XML", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-21-ohngea-modern-clone-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer HTTP mod_xml_curl over file writes plus ESL reloadxml because on-the-fly rendering is instant, cluster-safe, needs no NFS, and control-plane crash does not drop media calls."}, {"id": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_plugin_registry", "label": "Per-Tenant Plugin Registry", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-21-ohngea-modern-clone-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typed manifest.toml registry with domain_plugins toggle chosen to replicate FusionPBX 76-app modularity with license gating and lazy React chunks, hiding disabled plugins from nav and returning 403."}], "edges": [{"source": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_doc", "target": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_fastapi_monolith", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-21-ohngea-modern-clone-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_doc", "target": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_postgres_rls_partitioning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-21-ohngea-modern-clone-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_doc", "target": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_mod_xml_curl", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-21-ohngea-modern-clone-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_doc", "target": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_plugin_registry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-21-ohngea-modern-clone-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_doc", "target": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_rest_api_v1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-21-ohngea-modern-clone-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_rest_api_v1", "target": "docs_superpowers_specs_2026_08_22_webphone_design_webrtc_settings", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-08-21-ohngea-modern-clone-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_21_ohngea_modern_clone_design_postgres_rls_partitioning", "target": "docs_superpowers_specs_2026_08_22_webphone_design_webrtc_settings", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/superpowers/specs/2026-08-21-ohngea-modern-clone-design.md", "source_location": null, "weight": 1.0}], "hyperedges": []}