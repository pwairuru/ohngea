{"nodes": [{"id": "docs_superpowers_specs_2026_08_22_webphone_design_doc", "label": "WebPhone Browser SIP Client Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-22-webphone-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_22_webphone_design_webphone_context", "label": "WebPhoneContext Persistent Provider", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-22-webphone-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Context mounted at Nav level keeps SIP registration alive across popup close and route navigation; lazy sip.js import avoids bundle cost when tenant disabled."}, {"id": "docs_superpowers_specs_2026_08_22_webphone_design_webrtc_settings", "label": "webrtc_settings Tenant Table", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-22-webphone-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tenant-level single-row settings table gates enabled/auth_mode/wss_url centrally so WSS endpoint is admin-managed, not per-user drift, enforced by RLS and JWT domain match."}, {"id": "docs_superpowers_specs_2026_08_22_webphone_design_sip_js", "label": "sip.js SIP over WSS Client", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-22-webphone-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sip.js 0.21 picked over jssip for maintained TypeScript UserAgent/Registerer/Session API and smaller dependency surface; browsers cannot do raw SIP UDP so RFC 7118 WSS is required."}, {"id": "docs_superpowers_specs_2026_08_22_webphone_design_wss_transport", "label": "FreeSWITCH WSS Transport", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-22-webphone-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "wss-binding on sofia profile or TLS proxy required because browser WebRTC SIP must ride Secure WebSocket; localhost ws exception allows dev without TLS but prod must be wss."}], "edges": [{"source": "docs_superpowers_specs_2026_08_22_webphone_design_doc", "target": "docs_superpowers_specs_2026_08_22_webphone_design_webphone_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-22-webphone-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_22_webphone_design_doc", "target": "docs_superpowers_specs_2026_08_22_webphone_design_webrtc_settings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-22-webphone-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_22_webphone_design_doc", "target": "docs_superpowers_specs_2026_08_22_webphone_design_sip_js", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-22-webphone-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_22_webphone_design_doc", "target": "docs_superpowers_specs_2026_08_22_webphone_design_wss_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-22-webphone-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_22_webphone_design_webphone_context", "target": "docs_superpowers_specs_2026_08_23_webphone_ux_phase1_design_webphone_dock", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-08-22-webphone-desig